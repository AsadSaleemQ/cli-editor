{
  "name": "cli-editor",
  "displayName": "Codex CLI Editor",
  "description": "Codex CLI Editor turns enhanced Codex terminals into chat-style editors while preserving native behavior everywhere else.",
  "version": "0.3.3",
  "publisher": "asadsaleemq",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsadSaleemQ/cli-editor.git"
  },
  "homepage": "https://github.com/AsadSaleemQ/cli-editor#readme",
  "bugs": {
    "url": "https://github.com/AsadSaleemQ/cli-editor/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["codex", "terminal", "chat", "clipboard"],
  "activationEvents": [
    "onCommand:cliEditor.promptHome",
    "onCommand:cliEditor.promptEnd",
    "onCommand:cliEditor.smartPaste",
    "onCommand:terminalSmartPaste.paste"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "cliEditor.promptHome", "title": "Codex CLI Editor: Prompt Start" },
      { "command": "cliEditor.promptEnd", "title": "Codex CLI Editor: Prompt End" },
      { "command": "cliEditor.smartPaste", "title": "Codex CLI Editor: Smart Paste" }
    ],
    "keybindings": [
      { "command": "cliEditor.promptHome", "key": "ctrl+home", "when": "terminalFocus" },
      { "command": "cliEditor.promptEnd", "key": "ctrl+end", "when": "terminalFocus" },
      { "command": "cliEditor.smartPaste", "key": "ctrl+v", "when": "terminalFocus" }
    ]
  }
}
