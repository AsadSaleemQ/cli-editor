<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>CLI Editor third-party licenses</title></head>
<body>
<h1>CLI Editor third-party licenses</h1>
<p>This generated report contains the license texts for Rust packages linked into the distributed binaries.</p>
{{#each licenses}}
<section>
{{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
